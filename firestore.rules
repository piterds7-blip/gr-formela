rules_version = '2';
// GR Formela – kto ma dostęp do danych.
// Każde konto (logowanie hasłem) ma dokument uzytkownicy/{UID}:
//   rola: 'admin' (twórca) | 'user' (osoba) | 'agent' (komputer w oborze)
//   aktywny: true/false (blokada), zakladki: [...], zapis: true/false (prawo zmieniania danych)
// Dokumenty zmienia tylko twórca (zakładka „Dostęp” w aplikacji). Pierwszego twórcę dodaje się raz w konsoli Firebase.
// Uwaga: zakładki ukrywa aplikacja; baza rozróżnia: brak dostępu / podgląd / zapis / agent.
service cloud.firestore {
  match /databases/{database}/documents {

    function profil() {
      return get(/databases/$(database)/documents/uzytkownicy/$(request.auth.uid)).data;
    }
    function aktywne() {
      return request.auth != null
        && exists(/databases/$(database)/documents/uzytkownicy/$(request.auth.uid))
        && profil().aktywny == true;
    }
    function tworca()  { return aktywne() && profil().rola == 'admin'; }
    function osoba()   { return aktywne() && profil().rola in ['admin', 'user']; }
    function zapis()   { return osoba() && (profil().rola == 'admin' || profil().zapis == true); }
    function agent()   { return aktywne() && profil().rola == 'agent'; }

    // uprawnienia: każdy czyta tylko swój dokument (żeby aplikacja wiedziała, co pokazać); zmienia tylko twórca
    match /uzytkownicy/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || tworca();
      allow create, update: if tworca()
        && request.resource.data.rola in ['admin', 'user', 'agent']
        && request.resource.data.aktywny is bool
        && (uid != request.auth.uid
            || (request.resource.data.rola == 'admin' && request.resource.data.aktywny == true));
      // twórca nie może usunąć ani zablokować samego siebie (żeby nie odciąć się od aplikacji)
      allow delete: if tworca() && uid != request.auth.uid;
    }

    match /farms/{farmId} {
      allow read: if osoba();
      allow write: if zapis();
      match /{document=**} {
        allow read: if osoba();
        allow write: if zapis();
      }
      // agent może tylko wysyłać dane z Infodexu – nie czyta i nie zmienia niczego innego
      match /ix/{doc} {
        allow write: if agent();
      }
      match /ix_days/{doc} {
        allow write: if agent();
      }
    }
  }
}
